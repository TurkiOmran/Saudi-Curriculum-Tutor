# Copy to `.env` and fill in. `.env` is gitignored.

# HuggingFace token — required to download jinaai/jina-embeddings-v4
# (gated model; accept the license on the model page first).
# Create at: https://huggingface.co/settings/tokens
HF_TOKEN=

# OpenRouter API key — required when llm.backend is `openrouter` in
# config.yaml (RESPONSE_WORKFLOW.md L3, L17, L20). Leave blank to keep
# using `backend: fake`, which runs the full graph end-to-end with
# canned replies and no network — no key needed.
#
# Recommended model: meta-llama/llama-3.3-70b-instruct (paid route via
# OpenRouter credits, ~$0.001 per Aleem query). The `:free` variant of
# the same model goes through a third-party upstream provider that
# rate-limits aggressively (HTTP 429) — credits do not unblock it.
# See SETUP.md §5 + §10 for the model-choice trade-offs.
#
# Create a key at: https://openrouter.ai/keys
# Browse live models at: https://openrouter.ai/api/v1/models
OPENROUTER_API_KEY=

# Where Chroma persists its data. Defaults to ./chroma if unset.
CHROMA_DIR=./chroma
