# Copy to `.env` and fill in. `.env` is gitignored.

# HuggingFace token — required to download jinaai/jina-embeddings-v4
# (gated model; accept the license on the model page first).
# Create at: https://huggingface.co/settings/tokens
HF_TOKEN=

# OpenRouter API key — required by the agentic pipeline's dev LLM backend
# (RESPONSE_WORKFLOW.md L3, L17). Free models like
# meta-llama/llama-3.1-8b-instruct:free are sufficient for development.
# Create at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Where Chroma persists its data. Defaults to ./chroma if unset.
CHROMA_DIR=./chroma
